"{\"scripts\":[{\"src\":\"https://us-assets.i.posthog.com/static/array.js\",\"text\":null},{\"src\":\"https://static.ads-twitter.com/uwt.js\",\"text\":null},{\"src\":\"https://s3-us-west-2.amazonaws.com/b2bjsstore/b/46DJ4HME1461/reb2b.js.gz\",\"text\":null},{\"src\":\"\",\"text\":\"\\n  {\\n    \\\"@context\\\": \\\"https://schema.org\\\",\\n    \\\"@type\\\": \\\"Dataset\\\",\\n    \\\"name\\\": \\\"CWE-bench\\\",\\n    \\\"alternateName\\\": \\\"CWE Bench\\\",\\n    \\\"url\\\": \\\"https://cwe-bench.com/\\\",\\n    \\\"description\\\": \\\"CWE-bench is a defensive cybersecurity benchmark. It measures whether coding agents can find and fix real vulnerabilities in real codebases. v2 has 250 audit-and-patch tasks across 185 distinct CWEs: a public set of 100 tasks (91 CWEs) that anyone can run, and a held-out set of 150 tasks that remains closed. Each task is graded by a deterministic verifier on whether the exploit is closed and legitimate behaviour still works.\\\",\\n    \\\"creator\\\": {\\n      \\\"@type\\\": \\\"Organization\\\",\\n      \\\"name\\\": \\\"Collinear AI\\\",\\n      \\\"url\\\": \\\"https://collinear.ai\\\",\\n      \\\"sameAs\\\": [\\n        \\\"https://x.com/collinearAI\\\",\\n        \\\"https://www.linkedin.com/company/collinearai/\\\"\\n      ]\\n    },\\n    \\\"publisher\\\": {\\n      \\\"@type\\\": \\\"Organization\\\",\\n      \\\"name\\\": \\\"Collinear AI\\\",\\n      \\\"url\\\": \\\"https://collinear.ai\\\"\\n    },\\n    \\\"citation\\\": {\\n      \\\"@type\\\": \\\"ScholarlyArticle\\\",\\n      \\\"name\\\": \\\"CWE-bench: Refocusing Agentic Security from Exploitation to Defense\\\",\\n      \\\"url\\\": \\\"https://arxiv.org/abs/2610.17020\\\",\\n      \\\"datePublished\\\": \\\"2026-10-12\\\",\\n      \\\"author\\\": [\\n        {\\n          \\\"@type\\\": \\\"Person\\\",\\n          \\\"name\\\": \\\"Gonzalo Gonzalez-Pumariega\\\"\\n        },\\n        {\\n          \\\"@type\\\": \\\"Person\\\",\\n          \\\"name\\\": \\\"Ajay Jagannath\\\"\\n        },\\n        {\\n          \\\"@type\\\": \\\"Person\\\",\\n          \\\"name\\\": \\\"Adit Jain\\\"\\n        },\\n        {\\n          \\\"@type\\\": \\\"Person\\\",\\n          \\\"name\\\": \\\"Guram Gogia\\\"\\n        },\\n        {\\n          \\\"@type\\\": \\\"Person\\\",\\n          \\\"name\\\": \\\"Soumyadeep Bakshi\\\"\\n        },\\n        {\\n          \\\"@type\\\": \\\"Person\\\",\\n          \\\"name\\\": \\\"Nazneen Rajani\\\"\\n        }\\n      ]\\n    },\\n    \\\"subjectOf\\\": [\\n      {\\n        \\\"@type\\\": \\\"BlogPosting\\\",\\n        \\\"headline\\\": \\\"CWE-bench v1: Defense Is the Harder Test\\\",\\n        \\\"url\\\": \\\"https://blog.collinear.ai/p/cwe-bench-v1\\\",\\n        \\\"datePublished\\\": \\\"2026-09-28\\\",\\n        \\\"publisher\\\": {\\n          \\\"@type\\\": \\\"Organization\\\",\\n          \\\"name\\\": \\\"Collinear AI\\\",\\n          \\\"url\\\": \\\"https://collinear.ai\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"BlogPosting\\\",\\n        \\\"headline\\\": \\\"CWE-bench: Measuring Coding Agent Capabilities on Every Class of Known Vulnerability\\\",\\n        \\\"url\\\": \\\"https://blog.collinear.ai/p/cwe-bench\\\",\\n        \\\"datePublished\\\": \\\"2026-09-02\\\",\\n        \\\"publisher\\\": {\\n          \\\"@type\\\": \\\"Organization\\\",\\n          \\\"name\\\": \\\"Collinear AI\\\",\\n          \\\"url\\\": \\\"https://collinear.ai\\\"\\n        }\\n      }\\n    ],\\n    \\\"version\\\": \\\"v2 (2026-11-02)\\\",\\n    \\\"datePublished\\\": \\\"2026-08-04\\\",\\n    \\\"dateModified\\\": \\\"2026-11-18\\\",\\n    \\\"isAccessibleForFree\\\": true,\\n    \\\"distribution\\\": {\\n      \\\"@type\\\": \\\"DataDownload\\\",\\n      \\\"name\\\": \\\"CWE-bench public set (100 tasks)\\\",\\n      \\\"contentUrl\\\": \\\"https://huggingface.co/datasets/collinear-ai/cwe-bench\\\",\\n      \\\"encodingFormat\\\": \\\"Harbor task directories\\\"\\n    },\\n    \\\"license\\\": \\\"https://www.apache.org/licenses/LICENSE-2.0\\\",\\n    \\\"measurementTechnique\\\": \\\"Automated audit-and-patch task graded by a deterministic programmatic verifier: the exploit must no longer work and legitimate behaviour must still hold, with no partial credit.\\\",\\n    \\\"variableMeasured\\\": {\\n      \\\"@type\\\": \\\"PropertyValue\\\",\\n      \\\"name\\\": \\\"pass@1\\\",\\n      \\\"description\\\": \\\"Share of tasks a model solves on the first attempt under the deterministic programmatic verifier, averaged over four rollouts per task.\\\"\\n    },\\n    \\\"keywords\\\": [\\n      \\\"cybersecurity benchmark\\\",\\n      \\\"CWE\\\",\\n      \\\"vulnerability detection\\\",\\n      \\\"audit-and-patch\\\",\\n      \\\"coding agents\\\",\\n      \\\"LLM evaluation\\\",\\n      \\\"defensive security\\\",\\n      \\\"public benchmark\\\",\\n      \\\"held-out evaluation\\\"\\n    ]\\n  }\\n  \"},{\"src\":\"\",\"text\":\"\\n  {\\n    \\\"@context\\\": \\\"https://schema.org\\\",\\n    \\\"@type\\\": \\\"ItemList\\\",\\n    \\\"name\\\": \\\"CWE-bench v2 leaderboard\\\",\\n    \\\"description\\\": \\\"20 models ranked by pass@1 over all 250 tasks (public and held-out), four rollouts per task at high reasoning.\\\",\\n    \\\"url\\\": \\\"https://cwe-bench.com/#leaderboard\\\",\\n    \\\"itemListOrder\\\": \\\"https://schema.org/ItemListOrderDescending\\\",\\n    \\\"numberOfItems\\\": 20,\\n    \\\"itemListElement\\\": [\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 1,\\n        \\\"name\\\": \\\"Claude Fable 5.2\\\",\\n        \\\"description\\\": \\\"pass@1 75.0%, pass@4 82.8% over 250 tasks; public set 78.5%, held-out set 72.7%. Average cost $7.85 per rollout, run in Claude Code.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 2,\\n        \\\"name\\\": \\\"Gemini 4 Neon\\\",\\n        \\\"description\\\": \\\"pass@1 70.7%, pass@4 76.4% over 250 tasks; public set 74.8%, held-out set 68.0%. Average cost $6.52 per rollout, run in Antigravity.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 3,\\n        \\\"name\\\": \\\"Gemini 4 Hydrogen\\\",\\n        \\\"description\\\": \\\"pass@1 68.1%, pass@4 78.0% over 250 tasks; public set 69.5%, held-out set 67.2%. Average cost $2.63 per rollout, run in Antigravity.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 4,\\n        \\\"name\\\": \\\"Gemini 4 Carbon\\\",\\n        \\\"description\\\": \\\"pass@1 67.3%, pass@4 76.4% over 250 tasks; public set 70.5%, held-out set 65.2%. Average cost $4.27 per rollout, run in Antigravity.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 5,\\n        \\\"name\\\": \\\"Claude Opus 5.5\\\",\\n        \\\"description\\\": \\\"pass@1 67.1%, pass@4 79.2% over 250 tasks; public set 67.3%, held-out set 67.0%. Average cost $1.85 per rollout, run in Claude Code.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 6,\\n        \\\"name\\\": \\\"GPT-6.2 Astra\\\",\\n        \\\"description\\\": \\\"pass@1 66.8%, pass@4 72.0% over 250 tasks; public set 67.0%, held-out set 66.7%. Average cost $4.32 per rollout, run in Codex.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 7,\\n        \\\"name\\\": \\\"Muse Wonder\\\",\\n        \\\"description\\\": \\\"pass@1 66.1%, pass@4 78.8% over 250 tasks; public set 64.8%, held-out set 67.0%. Average cost $2.73 per rollout, run in opencode.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 8,\\n        \\\"name\\\": \\\"GPT-6.2 Sol\\\",\\n        \\\"description\\\": \\\"pass@1 66.0%, pass@4 74.0% over 250 tasks; public set 66.5%, held-out set 65.7%. Average cost $0.81 per rollout, run in Codex.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 9,\\n        \\\"name\\\": \\\"Gemini 4 Argon\\\",\\n        \\\"description\\\": \\\"pass@1 65.0%, pass@4 77.2% over 250 tasks; public set 67.8%, held-out set 63.2%. Average cost $3.70 per rollout, run in Antigravity.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 10,\\n        \\\"name\\\": \\\"GPT-6 Astra\\\",\\n        \\\"description\\\": \\\"pass@1 64.2%, pass@4 72.8% over 250 tasks; public set 63.8%, held-out set 64.5%. Average cost $3.87 per rollout, run in Codex.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 11,\\n        \\\"name\\\": \\\"Hy4\\\",\\n        \\\"description\\\": \\\"pass@1 64.1%, pass@4 78.4% over 250 tasks; public set 63.8%, held-out set 64.3%. Average cost $1.35 per rollout, run in Claude Code.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 12,\\n        \\\"name\\\": \\\"Claude Sonnet 5.5\\\",\\n        \\\"description\\\": \\\"pass@1 61.4%, pass@4 74.8% over 250 tasks; public set 61.2%, held-out set 61.5%. Average cost $0.58 per rollout, run in Claude Code.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 13,\\n        \\\"name\\\": \\\"GPT-6.1 Terra\\\",\\n        \\\"description\\\": \\\"pass@1 60.0%, pass@4 69.2% over 250 tasks; public set 65.0%, held-out set 56.7%. Average cost $0.44 per rollout, run in Codex.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 14,\\n        \\\"name\\\": \\\"DeepSeek-V4.1-Flash (1017)\\\",\\n        \\\"description\\\": \\\"pass@1 57.6%, pass@4 73.6% over 250 tasks; public set 57.0%, held-out set 58.0%. Average cost $0.04 per rollout, run in opencode.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 15,\\n        \\\"name\\\": \\\"Grok 4.7\\\",\\n        \\\"description\\\": \\\"pass@1 54.7%, pass@4 71.2% over 250 tasks; public set 55.5%, held-out set 54.2%. Average cost $2.97 per rollout, run in opencode.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 16,\\n        \\\"name\\\": \\\"Hy4 Preview\\\",\\n        \\\"description\\\": \\\"pass@1 47.3%, pass@4 64.4% over 250 tasks; public set 52.0%, held-out set 44.2%. Average cost $0.43 per rollout, run in opencode.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 17,\\n        \\\"name\\\": \\\"Mistral Large 4\\\",\\n        \\\"description\\\": \\\"pass@1 45.6%, pass@4 60.4% over 250 tasks; public set 46.3%, held-out set 45.2%. Average cost $0.37 per rollout, run in opencode.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 18,\\n        \\\"name\\\": \\\"Qwen3.8-Max (0902)\\\",\\n        \\\"description\\\": \\\"pass@1 45.4%, pass@4 64.8% over 250 tasks; public set 45.0%, held-out set 45.7%. Average cost $2.06 per rollout, run in opencode.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 19,\\n        \\\"name\\\": \\\"Kimi K3.1 Pro\\\",\\n        \\\"description\\\": \\\"pass@1 45.3%, pass@4 64.0% over 250 tasks; public set 41.5%, held-out set 47.8%. Average cost $0.96 per rollout, run in opencode.\\\"\\n      },\\n      {\\n        \\\"@type\\\": \\\"ListItem\\\",\\n        \\\"position\\\": 20,\\n        \\\"name\\\": \\\"GLM-5.3\\\",\\n        \\\"description\\\": \\\"pass@1 42.0%, pass@4 63.6% over 250 tasks; public set 44.0%, held-out set 40.7%. Average cost $0.58 per rollout, run in opencode.\\\"\\n      }\\n    ]\\n  }\\n  \"},{\"src\":\"\",\"text\":\"\\n  {\\n    \\\"@context\\\": \\\"https://schema.org\\\",\\n    \\\"@type\\\": \\\"FAQPage\\\",\\n    \\\"mainEntity\\\": [\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"What is CWE-bench?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"CWE-bench is a defensive cybersecurity benchmark from Collinear AI. It gives a coding agent a checkout of a real open-source repository and one instruction, audit the code and fix what you find. v2 has a public set of 100 tasks across 91 CWEs that anyone can run, and a held-out set of 150 tasks; together they cover 185 distinct CWEs.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"How well do AI coding agents do at finding and fixing vulnerabilities?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"Not well yet. Across v2’s 250 tasks the best model solves 75.0% at pass@1, and 13 tasks are unsolved by every model tested: 3 public, 10 held-out. Even the leader fails 43 tasks on every attempt.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"How are agents graded on CWE-bench?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"By a deterministic programmatic verifier: the exploit must no longer work and legitimate behaviour must still hold, with no partial credit. Panels of LLM judges were used while building the set to review and correct the verifiers, but every score on this page is the programmatic one, so anyone can reproduce it.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"Why not OWASP categories, as in v1?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"The OWASP Top 10 was a good fit for v1’s 73 CWEs, but many of v2’s 185 sit at its edges or outside it. v2 groups them into ten weakness classes of our own, in the spirit of OWASP. They are not an official taxonomy; each CWE’s class is shown in the CWE map on this page.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"How is a task assigned to a weakness class?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"By its most specific CWE (a MITRE Base or Variant entry) and the security property its tests check, never by a broad parent. Where two classes meet, the task goes with the mechanism being exploited, and error-handling and logic bugs go to K10. We checked the rule against MITRE’s full catalog (CWE 5.0): every software-security weakness in it fits one of the ten classes. Hardware-design, code-quality, documentation and performance CWEs are out of scope, because a security test cannot meaningfully fail them.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"Can I download and run the evaluation set?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"The public set, yes: its 100 tasks, the grader and the harness are on Hugging Face. The held-out set is not released, so it can keep tracking progress on tasks no model has seen.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"I think a task is wrong. What should I do?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"Tell us. Every task passed seven checks and a review by hand, but open-sourcing the set is how we find what those missed. Write to cyber@collinear.ai with the task name and what you saw.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"Can I submit a model for evaluation?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"Yes. Run the public set yourself, or ask Collinear to run your model on both sets; we report deterministic pass@1 and pass@4 on each.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"Can I license the separate training corpus?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"Yes. The 4,000+ task training corpus of real audit-and-patch tasks is available for teams building defensive-security capability, and evaluation tasks never appear in training deliveries.\\\"\\n        }\\n      },\\n      {\\n        \\\"@type\\\": \\\"Question\\\",\\n        \\\"name\\\": \\\"What is Collinear AI?\\\",\\n        \\\"acceptedAnswer\\\": {\\n          \\\"@type\\\": \\\"Answer\\\",\\n          \\\"text\\\": \\\"Collinear AI builds hard, verifiable RL environments and training data for frontier AI labs, spanning coding, computer use, and enterprise tool use. CWE-bench is its defensive-security benchmark. Learn more at collinear.ai.\\\"\\n        }\\n      }\\n    ]\\n  }\\n  \"},{\"src\":\"https://www.googletagmanager.com/gtag/js?id=G-753HWFHMY6\",\"text\":null},{\"src\":\"\",\"text\":\"\\n    window.dataLayer = window.dataLayer || [];\\n    function gtag(){dataLayer.push(arguments);}\\n    gtag('js', new Date());\\n    gtag('config', 'G-753HWFHMY6');\\n  \"},{\"src\":\"\",\"text\":\"!function(){var e=[\\\"identify\\\",\\\"page\\\",\\\"startAutoPage\\\",\\\"stopAutoPage\\\",\\\"startAutoIdentify\\\",\\\"stopAutoIdentify\\\"];function t(o){return Object.assign([],e.reduce(function(r,n){return r[n]=function(){return o.push([n,[].slice.call(arguments)]),o},r},{}))}window.unify||(window.unify=t(window.unify)),window.unifyBrowser||(window.unifyBrowser=t(window.unifyBrowser));var n=document.createElement(\\\"script\\\");n.async=!0,n.setAttribute(\\\"src\\\",\\\"https://tag.unifyintent.com/v1/WnrabJ8qATaQ6Ac7Nw52Ga/script.js\\\"),n.setAttribute(\\\"data-api-key\\\",\\\"wk_D