){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(\\\".\\\");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}p||((p=t.createElement(\\\"script\\\")).type=\\\"text/javascript\\\",p.crossOrigin=\\\"anonymous\\\",p.async=!0,p.src=s.api_host.replace(\\\".i.posthog.com\\\",\\\"-assets.i.posthog.com\\\")+\\\"/static/array.js\\\",p.onerror=function(){p=null},(r=t.getElementsByTagName(\\\"script\\\")[0]).parentNode.insertBefore(p,r));var u=e;for(void 0!==a?u=e[a]=[]:a=\\\"posthog\\\",u.people=u.people||[],Object.defineProperty(u,\\\"toString\\\",{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e=\\\"posthog\\\";return\\\"posthog\\\"!==a&&(e+=\\\".\\\"+a),t||(e+=\\\" (stub)\\\"),e}}),Object.defineProperty(u.people,\\\"toString\\\",{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+\\\".people (stub)\\\"}}),o=\\\"init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug\\\".split(\\\" \\\"),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);\\n    posthog.init('phc_kvFDuyzKxUcMBTNUL77hmjr2RdDm4ywEV9Gt3S2GbN4b', {\\n      api_host: 'https://us.i.posthog.com',\\n      defaults: '2026-05-30',\\n    });\\n  }\\n  \"},{\"src\":\"https://us-assets.i.posthog.com/static/1.451.2/surveys.js\",\"text\":null},{\"src\":\"\",\"text\":\"\\n        /* v2 set switch: each row carries its scores and cost for all three\\n           sets; a switch copies the chosen set into the live data-p1/data-p4\\n           attributes and cells, then re-runs the current sort so ranks and\\n           bars follow. */\\n        (function () {\\n          var seg = document.querySelectorAll('#leaderboard .seg[data-set]');\\n          var LABEL = { all: 'all 250 tasks, public and held-out', 'public': 'the 100 public tasks', 'heldout': 'the 150 held-out tasks' };\\n          function pick(set) {\\n            [].forEach.call(seg, function (b) {\\n              var on = b.getAttribute('data-set') === set;\\n              b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false');\\n            });\\n            var lab = document.querySelector('#leaderboard [data-set-label]'); if (lab) lab.textContent = LABEL[set];\\n            [].forEach.call(document.querySelectorAll('#leaderboard tr[data-model]'), function (tr) {\\n              ['p1', 'p4'].forEach(function (k) {\\n                var v = tr.getAttribute('data-' + k + '-' + set);\\n                tr.setAttribute('data-' + k, v);\\n                var td = tr.querySelector('td[data-k=\\\"' + k + '\\\"]');\\n                if (v) td.textContent = v + '%';\\n                else td.innerHTML = '<span class=\\\"lb-na\\\" title=\\\"Public-set results only so far\\\">&mdash;</span>';\\n              });\\n              var cost = tr.getAttribute('data-cost-' + set);\\n              var cell = tr.querySelector('.lb-cost');\\n              if (cost) cell.textContent = '$' + cost;\\n              else cell.innerHTML = tr.getAttribute('data-p1-' + set)\\n                ? '<span class=\\\"lb-na\\\" title=\\\"No cost figure for this model yet\\\">&mdash;</span>'\\n                : '<span class=\\\"lb-na\\\" title=\\\"Public-set results only so far\\\">&mdash;</span>';\\n            });\\n            var active = document.querySelector('#leaderboard .lb-sortbtn.is-on');\\n            if (active) active.click();\\n          }\\n          [].forEach.call(seg, function (b) { b.addEventListener('click', function () { pick(b.getAttribute('data-set')); }); });\\n        })();\\n      \"},{\"src\":\"https://cwe-bench.com/countdown.js?v=2\",\"text\":null},{\"src\":\"https://cwe-bench.com/ambient.js\",\"text\":null},{\"src\":\"https://cwe-bench.com/assets/vendor/echarts.min.js\",\"text\":null},{\"src\":\"https://cwe-bench.com/assets/charts/data-v2.js?v=13\",\"text\":null},{\"src\":\"https://cwe-bench.com/assets/charts/cwe-map-data-v2.js?v=8\",\"text\":null},{\"src\":\"https://cwe-bench.com/version.js?v=6\",\"text\":null},{\"src\":\"https://cwe-bench.com/charts.js?v=90\",\"text\":null},{\"src\":\"\",\"text\":\"\\n    /* The frontier tile names exactly the models the cost chart rings in\\n       orange. Both read the same points and run the same walk, so the two\\n       cannot drift apart when the numbers change. data.js is deferred, so\\n       this waits for it. */\\n    document.addEventListener('DOMContentLoaded', function () {\\n      var d = window.CWEB_DATA;\\n      var names = document.querySelector('[data-pareto-models]');\\n      if (!d || !d.cost || !names) return;\\n      var TILE_ORDER = window.CWEB_VERSION === 'v0' ? ['Fable 5', 'Gemini 3.7 Flash', 'GPT-5.6'] : ['Claude Fable 5.2', 'Gemini 4 Neon', 'Gemini 4 Hydrogen', 'Gemini 4 Carbon', 'Grok 4.7', 'Gemini 4 Argon', 'GPT-6 Astra', 'Claude Opus 5.5', 'GPT-6.2 Astra', 'GPT-6.2 Sol', 'Hy4', 'Claude Sonnet 5.5', 'GPT-6.1 Terra', 'DeepSeek V4.1 Flash'];  /* v1: leaderboard rank */\\n\\n      var front = d.cost.points.slice()\\n        .sort(function (a, b) { return a.cost - b.cost; })\\n        .reduce(function (keep, p) {\\n          /* d.cost.minGain (v1) asks a member to beat the next-cheapest by a\\n             margin; a fifth of a point for five times the cost is noise. */\\n          if (!keep.length || p.pass1 > keep[keep.length - 1].pass1 + (d.cost.minGain || 0)) keep.push(p);\\n          return keep;\\n        }, [])\\n        /* Models within leadTol of the top score are tied for the lead and\\n           join the frontier whatever they cost. */\\n        .concat(d.cost.points.filter(function (p, i, all) {\\n          var top = Math.max.apply(null, all.map(function (q) { return q.pass1; }));\\n          return p.pass1 >= top - (d.cost.leadTol || 0);\\n        }))\\n        .filter(function (p, i, arr) { return arr.indexOf(p) === i; })\\n        .sort(function (a, b) { return b.pass1 - a.pass1; })\\n        /* Frontier members under 40% are cheap rather than capable. The tile\\n           is a shortlist, so it carries only the ones worth considering; the\\n           chart still draws the whole frontier. */\\n        .filter(function (p) { return window.CWEB_VERSION === 'v0' ? p.pass1 > 40 : true; })\\n        .sort(function (a, b) {\\n          var ai = TILE_ORDER.indexOf(a.model);\\n          var bi = TILE_ORDER.indexOf(b.model);\\n          if (ai === -1 && bi === -1) return b.pass1 - a.pass1;\\n          if (ai === -1) return 1;\\n          if (bi === -1) return -1;\\n          return ai - bi;\\n        });\\n\\n      /* Vendored marks, keyed on the stable model name rather than the\\n         display string. A model with no mark still gets the slot, so the\\n         names stay aligned down the column. */\\n      var LOGOS = {\\n        'Fable 5': 'anthropic', 'Opus 4.8': 'anthropic',\\n        'GPT-5.6': 'openai',\\n        'Gemini 3.7 Flash': 'gemini', 'Gemini 3.5 Flash': 'gemini',\\n        'GPT-6 Astra': 'openai', 'Claude Fable 5.1': 'anthropic', 'Gemini 3.8 Flash Cyber': 'gemini',\\n        'Muse Spark 1.3': 'meta', 'DeepSeek V4 Flash': 'deepseek',\\n        'Claude Opus 5.5': 'anthropic', 'DeepSeek V4.1 Flash': 'deepseek', 'GPT-6 Sol': 'openai',\\n        'Hy4 Preview': 'hunyuan', 'Hy4': 'hunyuan', 'Claude Fable 5.2': 'anthropic', 'Grok 4.7': 'grok', 'Grok 4.6': 'grok', 'Gemini 4 Argon': 'gemini', 'Gemini 4 Carbon': 'gemini', 'Gemini 4 Hydrogen': 'gemini',\\n        'Claude Sonnet 5.5': 'anthropic', 'GPT-6.2 Sol': 'openai', 'GPT-6.2 Astra': 'openai', 'GPT-6.1 Terra': 'openai',\\n        'Gemini 4 Neon': 'gemini'\\n      };\\n      var TILE_DISPLAY = {\\n        'Gemini 3.7 Flash': 'Gemini 3.8 Flash Cyber'\\n      };\\n\\n      names.textContent = '';\\n      front.forEach(function (p) {\\n        var row = document.createElement('span');\\n        row.className = 'frontier-model';\\n\\n        var mark = LOGOS[p.model];\\n        var slot;\\n        if (mark) {\\n          slot = document.createElement('img');\\n          slot.className = 'frontier-logo';\\n          slot.src = 'assets/models/' + mark + '.svg';\\n          slot.width = 12; slot.height = 12;\\n          slot.alt = '';            /* decorative: the name is right beside it */\\n        } else {\\n          slot = document.createElement('span');\\n          slot.className = 'frontier-logo';\\n        }\\n        row.appendChild(slot);\\n        var name = document.createElement('span');\\n        name.className = 'frontier-name';\\n        /* Real spaces, not nbsp: the tile is narrower than the longest\\n           model name once a mark sits beside it, so the name has to be\\n           allowed to wrap rather than run past the tile edge. */\\n        name.textContent = TILE_DISPLAY[p.model] ||\\n          (window.CWEB_LABEL ? window.CWEB_LABEL(p.model) : (p.display || p.model));\\n        row.appendChild(name);\\n        names.appendChild(row);\\n      });\\n    });\\n\\n    (function () {\\n      var btn = document.querySelector('.bibtex-copy');\\n      if (!btn) return;\\n      btn.addEventListener('click', function () {\\n        var text = document.getElementById('bibtex-src').textContent;\\n        function done(ok) {\\n          btn.textContent = ok ? 'Copied ✓' : 'Copy failed';\\n          btn.classList.toggle('is-copied', ok);\\n          setTimeout(function () { btn.textContent = 'Copy'; btn.classList.remove('is-copied'); }, 2000);\\n        }\\n        if (navigator.clipboard && navigator.clipboard.writeText) {\\n          navigator.clipboard.writeText(text).then(function () { done(true); }, function () { done(false); });\\n        } else {\\n          var ta = document.createElement('textarea');\\n          ta.value = text; document.body.appendChild(ta); ta.select();\\n          try { done(document.execCommand('copy')); } catch (e) { done(false); }\\n          document.body.removeChild(ta);\\n        }\\n      });\\n    })();\\n\\n    /* Persistent top nav: hairline appears once the page is scrolled. */\\n    (function () {\\n      var bar = document.querySelector('.topbar');\\n      if (!bar) return;\\n      function update() { bar.classList.toggle('is-stuck', window.scrollY > 4); }\\n      window.addEventListener('scroll', update, { passive: true });\\n      update();\\n    })();\\n\\n    /* Mobile navigation. Below the breakpoint the links live in a panel under\\n       the bar; above it they are the bar, and the panel state must not leak\\n       into that (a stray hidden attribute would take the desktop nav out of\\n       the accessibility tree). One source of truth: the media query. */\\n    (function () {\\n      var btn = document.getElementById('navtoggle');\\n      var nav = document.getElementById('topnav');\\n      if (!btn || !nav) return;\\n\\n      var mq = window.matchMedia('(max-width: 899px)');\\n      var open = false;\\n\\n      function links() { return [].slice.call(nav.querySelectorAll('.toplink')); }\\n\\n      function setOpen(next, returnFocus) {\\n        open = next;\\n        btn.setAttribute('aria-expanded', next ? 'true' : 'false');\\n        btn.setAttribute('aria-label', next ? 'Close navigation' : 'Open navigation');\\n        if (next) {\\n          nav.removeAttribute('hidden');\\n          var first = links()[0];\\n          if (first) first.focus();\\n        } else {\\n          nav.hidden = true;\\n          if (returnFocus) btn.focus();\\n        }\\n      }\\n\\n      /* Desktop owns the nav outright: no hidden attribute, no expanded state,\\n         and the button is display:none so it leaves the tab order by itself. */\\n      function applyMode() {\\n        if (mq.matches) {\\n          if (!open) nav.hidden = true;\\n        } else {\\n          nav.removeAttribute('hidden');\\n          open = false;\\n          btn.setAttribute('aria-expanded', 'false');\\n          btn.setAttribute('aria-label', 'Open navigation');\\n        }\\n      }\\n\\n      btn.addEventListener('click', function () { setOpen(!open, !open ? false : true); });\\n\\n      /* Following a link navigates within the page, so the panel has done its\\n         job; focus goes to the destination, not back to the button. */\\n      nav.addEventListener('click', function (e) {\\n        if (open && e.target.closest('.toplink, .topcta')) setOpen(false, false);\\n      });\\n\\n      document.addEventListener('keydown', function (e) {\\n        if (e.key === 'Escape' && open) setOpen(false, true);\\n      });\\n\\n      document.addEventListener('click', function (e) {\\n        if (open && !nav.contains(e.target) && !btn.contains(e.target)) setOpen(false, false);\\n      });\\n\\n      /* Marks the section the reader is in: the last in-page target whose top\\n         has scrolled up past the bar, or the final one once the page bottom is\\n         reached. Targets resolve on each pass, because the version switch\\n         drops one of the two leaderboards after this script has run. */\\n      var spyLinks = links().filter(function (a) { return /^#/.test(a.getAttribute('href') || ''); });\\n      var spyQueued = false;\\n      function markCurrent() {\\n        var y = (document.scrollingElement || document.documentElement).scrollTop || window.pageYOffset || 0;\\n        /* A section counts once its top is at or above where the browser\\n           itself would park it on navigation: the page's scroll padding plus\\n           the section's own scroll margin, with a little slack. */\\n        var pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;\\n        var atEnd = window.innerHeight + y >= document.documentElement.scrollHeight - 2;\\n        var current = null;\\n        spyLinks.forEach(function (a) {\\n          var sec = document.querySelector(a.getAttribute('href'));\\n          if (!sec) return;\\n          var margin = parseFloat(getComputedStyle(sec).scrollMarginTop) || 0;\\n          if (sec.getBoundingClientRect().top <= pad + margin + 12) current = a;\\n        });\\n        if (atEnd && spyLinks.length) current = spyLinks[spyLinks.length - 1];\\n        spyLinks.forEach(function (a) {\\n          if (a === current) a.setAttribute('aria-current', 'page');\\n          else a.removeAttribute('aria-current');\\n        });\\n      }\\n      function queueMark() {\\n        if (spyQueued) return;\\n        spyQueued = true;\\n        requestAnimationFrame(function () { spyQueued = false; markCurrent(); });\\n      }\\n      window.addEventListener('scroll', queueMark, { passive: true });\\n      window.addEventListener('resize', queueMark);\\n      window.addEventListener('hashchange', queueMark);\\n      window.addEventListener('load', markCurrent);\\n      markCurrent();\\n\\n      /* Both listeners: viewport emulation can change what the query matches\\n         without firing either one on its own. */\\n      if (mq.addEventListener) mq.addEventListener('change', applyMode);\\n      else if (mq.addListener) mq.addListener(applyMode);\\n      window.addEventListener('resize', applyMode);\\n\\n      applyMode();\\n    })();\\n\\n\\n    /* v1 leaderboard: click a score column to rank by it. Each row carries all\\n       four scores as data attributes; a click reorders the tbody groups, redraws\\n       the bars from the chosen score and rewrites the shared ranks. A tie breaks\\n       on the other score from the same grader (p1 <-> p4, j1 <-> j4), then on\\n       the served order, so the rows never reshuffle arbitrarily. */\\n    (function () {\\n      var table = document.querySelector('.tbl-lb-both');\\n      if (!table) return;\\n      var groups = [].slice.call(table.querySelectorAll('tbody.lb-group'));\\n      var served = groups.slice();\\n      var PAIR = { p1: 'p4', p4: 'p1', j1: 'j4', j4: 'j1' };\\n      function val(g, k) {\\n        var v = g.querySelector('tr[data-model]').getAttribute('data-' + k);\\n        return v === '' || v === null ? -1 : parseFloat(v);\\n      }\\n      function sortBy(k) {\\n        var ranked = groups.slice().sort(function (a, b) {\\n          return val(b, k) - val(a, k) || val(b, PAIR[k]) - val(a, PAIR[k]) || served.indexOf(a) - served.indexOf(b);\\n        });\\n        ranked.forEach(function (g) {\\n          var v = val(g, k);\\n          var higher = ranked.filter(function (x) { return val(x, k) > v; }).length;\\n          var tied = ranked.filter(function (x) { return val(x, k) === v; }).length > 1;\\n          g.querySelector('.lb-rank').textContent = v < 0 ? '' : (tied ? 'T' : '') + (higher + 1);\\n          g.querySelector('.lb-fill').style.width = (v < 0 ? 0 : v) + '%';\\n          [].slice.call(g.querySelectorAll('td[data-k]')).forEach(function (td) {\\n            td.classList.toggle('is-sorted', td.getAttribute('data-k') === k);\\n          });\\n          table.appendChild(g);\\n        });\\n        [].slice.call(table.querySelectorAll('th[data-k]')).forEach(function (th) {\\n          var on = th.getAttribute('data-k') === k;\\n          th.setAttribute('aria-sort', on ? 'descending' : 'none');\\n          th.querySelector('button').classList.toggle('is-on', on);\\n        });\\n      }\\n      table.querySelector('thead').addEventListener('click', function (e) {\\n        var b = e.target.closest('button[data-k]');\\n        if (b) sortBy(b.getAttribute('data-k'));\\n      });\\n    })();\\n  \"},{\"src\":\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\",\"text\":null}],\"links\":[{\"tag\":\"A\",\"url\":\"https://collinear.ai/\"},{\"tag\":\"A\",\"url\":\"https://cwe-bench.com/#leaderboard\"},{\"tag\":\"A\",\"url\":\"https://cwe-bench.com/#quality\"},{\"tag\":\"A\",\"url\":\"https://cwe-bench.com/#how\"},{\"tag\":\"A\",\"url\":\"https://cwe-bench.com/#contact\"},{\"tag\":\"A\",\"url\":\"https://arxiv.org/abs/2610.17020\"},{\"tag\":\"A\",\"url\":\"https://collinear.ai/\"},{\"tag\":\"A\",\"url\":\"mailto:cyber@collinear.ai\"},{\"tag\":\"A\",\"url\":\"https://cwe-bench.com/\"},{\"tag\":\"A\",\"url\":\"https://cwe-bench.com/v1\"},{\"tag\":\"A\",\"url\":\"https://cwe-bench.com/v0\"},{\"tag\":\"A\",\"url\":\"https://huggingface.co/datasets/collinear-ai/cwe-bench\"},{\"tag\":\"A\",\"url\":\"https://arxiv.org/abs/2610.17020\"},{\"tag\":\"IMG\",\"url\":\"https://cwe-bench.com/assets/models/anthropic.svg\"},{\"tag\":\"IMG\",\"url\":\"https://cwe-bench.com/assets/models/gemini.svg\"},{\"tag\":\"IMG\",\"url\":\"https://cwe-bench.com/assets/models/gemini.svg\"},{\"tag\":\"IMG\",\"url\":\"https://cwe-bench.com/assets/models/anthropic.svg\"},{\"tag\":\"IMG\",\"url\":\"https://cwe-bench.com/assets/models/openai.svg\"},{\"tag\":\"IMG\",\"url\":\"https://cwe-bench.com/assets/models/anthropic.svg\"},{\"tag\":\"IMG\",\"url\":\"https://cwe-bench.com/assets/models/openai.svg\"},{\"tag\":\"IMG\",\"url\":\"https://cwe-bench.com/assets/models/deepseek.svg\"},{\"tag\":\"A\",\"url\":\"https://cwe-bench.com/#corpus\"},{\"tag\":\"A\",\"url\":\"https://github.com/whisperfish/blurhash-rs\"},{\"tag\":\"A\",\"url\":\"https://huggingface.co/datasets/collinear-ai/cwe-bench\"},{\"tag\":\"A\",\"url\":\"mailto:cyber@collinear.ai\"},{\"tag\":\"A\",\"url\":\"https://collinear.ai/\"},{\"tag\":\"A\",\"url\":\"https://arxiv.org/abs/2610.17020\"},{\"tag\":\"A\",\"url\":\"mailto:cyber@collinear.ai\"},{\"tag\":\"A\",\"url\":\"https://collinear.ai/\"},{\"tag\":\"IMG\",\"url\":\"https://t.co/1/i/adsct?bci=4&dv=Asia%2FJerusalem%26en-US%26Google%20Inc.%26MacIntel%26127%26800%26600%2610%2624%26800%26600%260%26na%261&eci=3&event=%7B%7D&event_id=209ff7b5-bafe-44c7-b162-842ecc4be4d2&integration=advertiser&p_id=Twitter&p_user_id=0&pl_id=80be9391-c94b-49c2-86e1-b718250c7571&tw_ch_fvl=Not%3AA-Brand%2F8.0.0.0%2CChromium%2F156.0.8078.80&tw_ch_pv=26.3.1&tw_document_href=https%3A%2F%2Fcwe-bench.com%2F&tw_engaged_ms=1&tw_iframe_status=0&tw_pid_src=1&tw_session_count=1&tw_session_id=1795068034567-435211616&tw_session_start=1&twpid=tw.1795068034567.274845524620424000&txn_id=rg14q&type=javascript&version=2.4.12\"},{\"tag\":\"IMG\",\"url\":\"https://analytics.twitter.com/1/i/adsct?bci=4&dv=Asia%2FJerusalem%26en-US%26Google%20Inc.%26MacIntel%26127%26800%26600%2610%2624%26800%26600%260%26na%261&eci=3&event=%7B%7D&event_id=209ff7b5-bafe-44c7-b162-842ecc4be4d2&integration=advertiser&p_id=Twitter&p_user_id=0&pl_id=80be9391-c94b-49c2-86e1-b718250c7571&tw_ch_fvl=Not%3AA-Brand%2F8.0.0.0%2CChromium%2F156.0.8078.80&tw_ch_pv=26.3.1&tw_document_href=https%3A%2F%2Fcwe-bench.com%2F&tw_engaged_ms=1&tw_iframe_status=0&tw_pid_src=1&tw_session_count=1&tw_session_id=1795068034567-435211616&tw_session_start=1&twpid=tw.1795068034567.274845524620424000&txn_id=rg14q&type=javascript&version=2.4.12\"}]}"
